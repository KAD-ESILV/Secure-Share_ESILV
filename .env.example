# Copie ce fichier en ".env" et mets tes propres valeurs.
# Le fichier .env ne doit JAMAIS aller sur GitHub (NFR-SEC-02).

# --- Base de donnees ---
POSTGRES_DB=secureshare
POSTGRES_USER=secureshare
POSTGRES_PASSWORD=change-me

# --- Stockage SeaweedFS (S3) ---
S3_BUCKET=secureshare-files
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# --- Securite ---
JWT_SECRET=change-me-long-random-string
MASTER_KEY=change-me-64-hex-characters

# --- Services externes ---
VIRUSTOTAL_API_KEY=change-me
